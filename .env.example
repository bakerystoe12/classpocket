# Optional. No key is needed for the included sample or manual editing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional live Studio generation. Configure on the server; never in NEXT_PUBLIC variables.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# The terminal prints a random demo teacher password on first start if unset.
TEACHER_PASSWORD=
# Optional persistent SQLite directory (default ./data)
DATA_DIR=
# Optional base URL for classroom sharing, e.g. http://192.168.1.25:3000
NEXT_PUBLIC_APP_NAME=ClassPocket
