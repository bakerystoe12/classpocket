# ClassPocket configuration. Placeholders only — never commit real values.
# Copy to .env.local for local development; set the same names in Vercel for Production and Preview.

# --- Supabase (required for accounts, saving, timetables, invites, uploads) ---
# Project Settings → API. The publishable key (sb_publishable_…) is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_…). Never prefix with NEXT_PUBLIC_, never log it.
SUPABASE_SECRET_KEY=

# --- AI Studio via Claude (optional; without a key use templates/manual editing) ---
# Server-only: never use NEXT_PUBLIC_ for provider keys.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Legacy alternative: set AI_PROVIDER=groq to configure the bounded-template generator.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_ENABLED=true
# Durable daily budgets (UTC days), enforced in Postgres.
AI_USER_DAILY_LIMIT=20
AI_GUEST_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=100
AI_MAX_PROMPT_CHARS=600
# Includes model reasoning and program output. Each creation gets at most one validation repair.
AI_MAX_OUTPUT_TOKENS=10000
AI_TIMEOUT_MS=70000
# Only for tests: point at the mock server instead of Groq.
# GROQ_BASE_URL=http://127.0.0.1:4010

# --- App ---
# Canonical origin used for share links, auth redirects and the mutation origin check.
APP_URL=
# Extra origins allowed to send mutations (comma-separated), e.g. a custom domain.
ALLOWED_ORIGINS=
# Labels the judge preview clock and sample data as a demo.
DEMO_MODE=false
NEXT_PUBLIC_APP_NAME=ClassPocket

# --- Admin scripts only (npm run admin:teacher) ---
# TEACHER_INITIAL_PASSWORD=
